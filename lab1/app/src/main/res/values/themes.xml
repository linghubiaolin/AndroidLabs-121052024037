<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 应用主题：继承 Material3 的 DayNight 主题，自动适配深色模式 -->
    <style name="Theme.AndroidLab1" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_container</item>

        <!-- 状态栏：与页面同色，图标改成深色，避免白底白字看不见 -->
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- 底部导航栏同样处理 -->
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
