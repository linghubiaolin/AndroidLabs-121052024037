<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tv_dialog_header"
        style="@style/Theme.Lab3.DialogHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_header" />

    <EditText
        android:id="@+id/et_username"
        style="@style/Theme.Lab3.DialogField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:hint="@string/dialog_username"
        android:inputType="text"
        android:singleLine="true"
        android:backgroundTint="@color/app_orange" />

    <EditText
        android:id="@+id/et_password"
        style="@style/Theme.Lab3.DialogField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:hint="@string/dialog_password"
        android:inputType="textPassword"
        android:singleLine="true"
        android:backgroundTint="#BDBDBD" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/dialog_cancel"
            android:textColor="#757575"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <TextView
            android:id="@+id/btn_sign_in"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/dialog_sign_in"
            android:textColor="#009688"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>
