<?xml version="1.0" encoding="utf-8"?>
<!-- 根布局外包一层：顶部 Toolbar 作为 ActionBar，长按列表项时上下文操作栏挂在此处 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/app_orange_dark"
        app:title="@string/title_actionmode"
        app:titleTextColor="@color/white" />

    <!-- ListActivity 要求布局中存在 android:id="@android:id/list" 的 ListView -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF7F0"
        android:padding="16dp"
        android:text="@string/hint_actionmode"
        android:textColor="#757575"
        android:textSize="13sp" />

    <ListView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#EEEEEE"
        android:dividerHeight="1dp"
        android:listSelector="@android:color/transparent" />

</LinearLayout>
