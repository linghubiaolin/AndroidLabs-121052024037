<?xml version="1.0" encoding="utf-8"?>
<!-- 表格布局：整行白底 + 仅底部的 1dp 分隔线（负偏移把其余三边描边挤出可视区） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item
        android:left="-1dp"
        android:right="-1dp"
        android:top="-1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/grid_line" />
        </shape>
    </item>
</layer-list>
