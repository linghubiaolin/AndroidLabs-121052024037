<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 无 ActionBar：Compose 实验页使用 -->
    <style name="Theme.LayoutLab" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/teal_500</item>
        <item name="android:colorPrimaryDark">@color/teal_700</item>
        <item name="android:colorAccent">@color/teal_500</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- 带 ActionBar：四个 XML 布局实验页使用，标题由 manifest 的 label 提供 -->
    <style name="Theme.LayoutLab.ActionBar" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/teal_500</item>
        <item name="android:colorPrimaryDark">@color/teal_700</item>
        <item name="android:colorAccent">@color/teal_500</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- 线性布局：等分格子样式，避免在 16 个 TextView 上重复写属性 -->
    <style name="GridCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:background">@color/cell_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 表格布局：整行文字样式 -->
    <style name="TableText">
        <item name="android:padding">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

</resources>
